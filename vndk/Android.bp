cc_prebuilt_library_shared {
    name: "android.hardware.wifi-V2-ndk-v34",
    vendor: true,
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["android.hardware.wifi-V2-ndk-v34.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
}

