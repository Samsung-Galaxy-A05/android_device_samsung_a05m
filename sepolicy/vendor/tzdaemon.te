type tzdaemon, domain;
type tzdaemon_exec, exec_type, vendor_file_type, file_type;

# tzdaemon is started by init
init_daemon_domain(tzdaemon)

# properties
set_prop(tzdaemon, vendor_tzdaemon_prop)
set_prop(tzdaemon, vendor_secureos_prop)

# /mnt/vendor/
allow tzdaemon mnt_vendor_file:dir r_dir_perms;
allow tzdaemon mnt_vendor_file:dir { ioctl lock watch watch_reads };

# /dev/tzdev
allow tzdaemon tz_device:chr_file rw_file_perms;
allow tzdaemon tz_device:chr_file { ioctl map watch watch_reads };

# /dev/tziwsock
allow tzdaemon tz_user_device:chr_file rw_file_perms;
allow tzdaemon tz_user_device:chr_file { ioctl map watch watch_reads };

# socket
allow tzdaemon tz_socket:sock_file write;

# /dev/kmsg
allow tzdaemon kmsg_device:chr_file rw_file_perms;
allow tzdaemon kmsg_device:chr_file { ioctl map watch watch_reads };

# /data/vendor/tee
allow tzdaemon tee_vendor_data_file:dir create_dir_perms;
allow tzdaemon tee_vendor_data_file:dir { ioctl lock watch watch_reads reparent };

allow tzdaemon tee_vendor_data_file:file create_file_perms;
allow tzdaemon tee_vendor_data_file:file { map watch watch_reads };

# /proc/stat
allow tzdaemon proc_stat:file r_file_perms;
allow tzdaemon proc_stat:file { ioctl map watch watch_reads };

# /efs
allow tzdaemon efs_file:dir r_dir_perms;
allow tzdaemon efs_file:dir { ioctl lock watch watch_reads };

# /efs/tee
allow tzdaemon tee_efs_file:dir create_dir_perms;
allow tzdaemon tee_efs_file:dir { ioctl lock watch watch_reads reparent };

allow tzdaemon tee_efs_file:file create_file_perms;
allow tzdaemon tee_efs_file:file { map watch watch_reads };
